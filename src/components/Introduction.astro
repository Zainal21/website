---
import LogoPersonal from '~/assets/images/1000414638.png'
import { Image } from 'astro:assets'

const labels = {
  available: 'Available for work',
  hello: "Hello, I'm",
  role: 'Software Engineer (Backend Specialist) & DevOps Engineer',
  location: 'Surakarta, Central Java, Indonesia',
  experience: '5+ Years Experience',
  intro:
    "I'm a dynamic software engineer with over 5 years of hands-on experience crafting robust, scalable, and high-performance web and mobile applications. I find genuine satisfaction in elegant solutions that span the full technology stack — from refined frontend interfaces to efficient backend systems and thoughtful DevOps practices. Proficient in <strong>Laravel</strong>, <strong>CodeIgniter</strong>, <strong>Express.js</strong>, <strong>NestJS</strong>, <strong>Go Fiber</strong>, <strong>React.js</strong>, and <strong>Kotlin</strong>, I also bring infrastructure and cloud expertise, along with a growing command of AI agents and LLM tooling. I thrive in fast-paced environments as a fast learner and adaptable problem-solver, consistently delivering clean, maintainable code that drives real business impact.",
  ctaTitle: 'Looking for a software engineer?',
  ctaBody:
    "I'm currently open to new opportunities and exciting collaborations. Let's connect and create impactful technology solutions together!",
  ctaButton: 'Get in Touch',
  ctaBadge: 'Open to new opportunities',
  ctaHref: 'mailto:muhamadzaindev@gmail.com',
}
---

<div class="animate-fade-in-up opacity-0">
  <div class="flex flex-col sm:flex-row items-start gap-6">
    <!-- Profile image -->
    <div class="relative flex-shrink-0">
      <div
        class="h-[120px] w-[120px] overflow-hidden rounded-2xl border border-warm-200 bg-warm-100 dark:border-warm-800 dark:bg-dark-elevated"
      >
        <Image
          src={LogoPersonal}
          alt="Muhamad Zainal Arifin"
          class="h-full w-full object-cover"
        />
      </div>
      <span
        class="absolute -bottom-2.5 left-1/2 inline-flex -translate-x-1/2 items-center gap-1.5 whitespace-nowrap rounded-full border border-warm-200 bg-white px-2.5 py-1 text-xs font-medium text-warm-600 dark:border-warm-800 dark:bg-dark-surface dark:text-warm-400"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
        {labels.available}
      </span>
    </div>

    <!-- Text content -->
    <div class="flex-1">
      <p class="text-sm font-medium uppercase tracking-wide text-warm-500">
        {labels.hello}
      </p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">
        Muhamad Zainal Arifin
      </h1>
      <p class="mt-1 text-lg text-warm-600 dark:text-warm-400">
        {labels.role}
      </p>

      <!-- Quick stats -->
      <div
        class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-warm-500 dark:text-warm-500"
      >
        <span class="inline-flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4"
          >
            <path
              fill-rule="evenodd"
              d="m9.69 18.933.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z"
              clip-rule="evenodd"></path>
          </svg>
          {labels.location}
        </span>
        <span class="inline-flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4"
          >
            <path
              d="M10 9.25a.75.75 0 01.75.75v4.25a.75.75 0 01-1.5 0V10a.75.75 0 01.75-.75zM10 5.25a1 1 0 100 2 1 1 0 000-2z"
            ></path>
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm0-1.5a6.5 6.5 0 100-13 6.5 6.5 0 000 13z"
              clip-rule="evenodd"></path>
          </svg>
          {labels.experience}
        </span>
      </div>
    </div>
  </div>
</div>

<article class="prose lg:prose-lg mt-8 animate-fade-in-up opacity-0 stagger-2">
  <p class="leading-relaxed">
    <span set:html={labels.intro} />
  </p>
</article>

<!-- CTA Section -->
<div
  class="mt-8 rounded-2xl border border-warm-200 bg-warm-100/60 p-6 animate-fade-in-up opacity-0 stagger-3 dark:border-warm-800 dark:bg-dark-surface"
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p
        class="text-xs font-medium uppercase tracking-[0.18em] text-warm-500 dark:text-warm-500"
      >
        {labels.ctaBadge}
      </p>
      <h4
        class="mt-3 font-display text-xl font-semibold tracking-tight text-warm-900 dark:text-white"
      >
        {labels.ctaTitle}
      </h4>
      <p class="mt-2 max-w-2xl text-sm text-warm-600 dark:text-warm-400">
        {labels.ctaBody}
      </p>
    </div>
    <a
      href={labels.ctaHref}
      class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-warm-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-warm-700 dark:bg-warm-100 dark:text-warm-900 dark:hover:bg-white"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-5 w-5"
      >
        <path
          d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
        ></path>
        <path
          d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
        ></path>
      </svg>
      {labels.ctaButton}
    </a>
  </div>
</div>
