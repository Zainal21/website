---
import { getCollection } from 'astro:content'
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'

const posts = await getCollection('blog')
type BlogPost = (typeof posts)[number]
const sortedPosts = posts.sort(
  (a: BlogPost, b: BlogPost) =>
    new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
)

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
})

const categories = [
  ...new Set(posts.map((p: BlogPost) => p.data.category)),
].sort()

// Group posts by year
const postsByYear = sortedPosts.reduce(
  (acc: Record<string, BlogPost[]>, post: BlogPost) => {
    const year = new Date(post.data.published).getFullYear().toString()
    if (!acc[year]) acc[year] = []
    acc[year].push(post)
    return acc
  },
  {},
)
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a))
---

<Layout
  title="Blog | Muhamad Zainal Arifin"
  description="Thoughts on software development, backend engineering, DevOps, book reviews, and the tools I use."
>
  <BaseLayout>
    <!-- Header -->
    <section class="animate-fade-in-up opacity-0">
      <h1
        class="text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
      >
        Blog
      </h1>
      <p class="text-lg text-warm-600 dark:text-warm-400 mt-3 leading-relaxed">
        Thoughts on software development, book reviews, and life.
      </p>

      <!-- Category filter -->
      <div class="mt-6 flex flex-wrap gap-2">
        <button
          data-cat-filter="all"
          class="cat-filter-btn rounded-full border border-warm-900 px-3.5 py-1.5 text-sm font-medium text-white bg-warm-900 dark:border-warm-100 dark:bg-warm-100 dark:text-warm-900 transition-colors cursor-pointer"
        >
          All
        </button>
        {
          categories.map((cat) => (
            <button
              data-cat-filter={cat}
              class="cat-filter-btn rounded-full border border-warm-200 bg-white px-3.5 py-1.5 text-sm font-medium text-warm-600 hover:border-warm-400 transition-colors cursor-pointer dark:border-warm-800 dark:bg-dark-surface dark:text-warm-300 dark:hover:border-warm-600"
            >
              {cat}
            </button>
          ))
        }
      </div>
    </section>

    <!-- Posts grouped by year -->
    <div class="mt-10 space-y-12" id="blog-groups">
      {
        years.map((year, yearIndex) => (
          <section
            class="animate-fade-in-up opacity-0 blog-group"
            style={`animation-delay: ${0.1 + yearIndex * 0.05}s`}
          >
            <div class="flex items-center gap-4 mb-6">
              <h2 class="text-2xl font-display font-bold text-warm-400 dark:text-warm-600">
                {year}
              </h2>
              <div class="flex-1 h-px bg-warm-200 dark:bg-warm-800" />
              <span class="text-sm text-warm-400 dark:text-warm-600">
                {postsByYear[year].length}{' '}
                {postsByYear[year].length === 1 ? 'post' : 'posts'}
              </span>
            </div>

            <ul class="space-y-3">
              {postsByYear[year].map((post: BlogPost) => (
                <li data-post-category={post.data.category}>
                  <a
                    href={`/blog/${post.id}`}
                    class="card-soft p-4 sm:p-5 flex flex-col sm:flex-row gap-3 sm:gap-6 sm:items-center group hover-lift block"
                  >
                    <time
                      class="text-sm font-medium text-accent-600 dark:text-accent-400 whitespace-nowrap"
                      datetime={post.data.published.toISOString()}
                    >
                      {dateFormatter.format(post.data.published)}
                    </time>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2">
                        <button
                          type="button"
                          data-badge-cat={post.data.category}
                          class="cursor-pointer inline-flex items-center rounded-full border border-warm-200 bg-warm-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-warm-600 transition-colors hover:border-warm-400 dark:border-warm-800 dark:bg-dark-elevated dark:text-warm-300 dark:hover:border-warm-600"
                          title={`Filter by ${post.data.category}`}
                        >
                          {post.data.category}
                        </button>
                      </div>
                      <h3 class="font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors line-clamp-2 mt-1">
                        {post.data.title}
                      </h3>
                      {post.data.description && (
                        <p class="text-sm text-warm-600 dark:text-warm-400 mt-1 line-clamp-1">
                          {post.data.description}
                        </p>
                      )}
                    </div>
                    <div class="hidden sm:flex items-center text-warm-400 group-hover:text-accent-500 transition-colors">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- Empty state -->
    {
      sortedPosts.length === 0 && (
        <div class="text-center py-16">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-warm-100 dark:bg-dark-elevated flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-8 h-8 text-warm-400"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125"
              />
            </svg>
          </div>
          <p class="text-warm-600 dark:text-warm-400">
            No blog posts yet. Check back soon!
          </p>
        </div>
      )
    }

    <Footer />
  </BaseLayout>
</Layout>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLElement>('[data-cat-filter]'),
  )
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('[data-post-category]'),
  )

  const select = (btn: HTMLElement) => {
    const cat = btn.getAttribute('data-cat-filter')
    buttons.forEach((b) => {
      const active = b === btn
      // Apply active styles via class toggles (default vs selected)
      b.classList.toggle(
        'border-warm-900',
        active,
      )
      b.classList.toggle('bg-warm-900', active)
      b.classList.toggle('text-white', active)
      b.classList.toggle('dark:border-warm-100', active)
      b.classList.toggle('dark:bg-warm-100', active)
      b.classList.toggle('dark:text-warm-900', active)
      b.classList.toggle('border-warm-200', !active)
      b.classList.toggle('bg-white', !active)
      b.classList.toggle('text-warm-600', !active)
      b.classList.toggle('dark:border-warm-800', !active)
      b.classList.toggle('dark:bg-dark-surface', !active)
      b.classList.toggle('dark:text-warm-300', !active)
    })

    items.forEach((item) => {
      const show = cat === 'all' || item.getAttribute('data-post-category') === cat
      item.style.display = show ? '' : 'none'
    })
  }

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => select(btn as HTMLElement)),
  )

  // Post category badges click -> same filter
  const firstMatch = (cat: string) =>
    buttons.find((b) => b.getAttribute('data-cat-filter') === cat)

  Array.from(document.querySelectorAll<HTMLElement>('[data-badge-cat]')).forEach(
    (badge) =>
      badge.addEventListener('click', () => {
        const cat = badge.getAttribute('data-badge-cat')
        const target = firstMatch(cat!) || buttons[0]
        select(target)
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }),
  )
</script>