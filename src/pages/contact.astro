---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import GithubIcon from '~/icons/GithubIcon.astro'
import LinkedInIcon from '~/icons/LinkedInIcon.astro'

const email = 'muhamadzaindev@gmail.com'
const contactChannels = [
  {
    label: 'Email',
    value: email,
    href: `mailto:${email}`,
    description:
      'Best way to reach me for project inquiries and opportunities.',
    icon: 'mail',
  },
  {
    label: 'LinkedIn',
    value: 'in/muhammad-zainal-arifin',
    href: 'https://www.linkedin.com/in/muhammad-zainal-arifin',
    description: 'Connect with me professionally and follow my career updates.',
    icon: 'linkedin',
  },
  {
    label: 'GitHub',
    value: 'github.com/Zainal21',
    href: 'https://github.com/Zainal21',
    description: 'Browse my open-source work and personal projects.',
    icon: 'github',
  },
  {
    label: 'Personal website',
    value: 'zainarief.my.id',
    href: 'https://zainarief.my.id',
    description: 'My personal page and additional links.',
    icon: 'globe',
  },
]
---

<Layout
  title="Contact | Muhamad Zainal Arifin"
  description="Get in touch with Muhamad Zainal Arifin for project inquiries and opportunities."
  lang="en"
>
  <BaseLayout>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm text-warm-500 dark:text-warm-400 hover:text-warm-700 dark:hover:text-warm-300 transition-colors mb-8 group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
      >
        <path
          fill-rule="evenodd"
          d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z"
          clip-rule="evenodd"></path>
      </svg>
      Back to home
    </a>

    <article class="animate-fade-in-up opacity-0">
      <h1
        class="text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
      >
        Let's Connect
      </h1>
      <p class="text-warm-600 dark:text-warm-400 mt-2">
        I'm open to new opportunities and exciting collaborations. Send me an
        email or reach out through any of the channels below.
      </p>

      <a
        href={`mailto:${email}`}
        class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4 rounded-2xl border border-accent-200 bg-gradient-to-br from-white via-accent-50/60 to-warm-100 p-5 shadow-sm dark:border-accent-500/25 dark:from-dark-surface dark:via-black dark:to-dark-surface dark:shadow-2xl dark:shadow-accent-950/25 sm:p-6"
      >
        <div
          class="w-12 h-12 flex items-center justify-center bg-accent-500 rounded-xl text-white flex-shrink-0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-6 h-6"
          >
            <path
              d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
            ></path>
            <path
              d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
            ></path>
          </svg>
        </div>
        <div class="flex-1">
          <p
            class="text-sm font-semibold uppercase tracking-wider text-warm-500 dark:text-warm-500"
          >
            Email me
          </p>
          <p
            class="mt-1 text-lg font-semibold text-warm-900 dark:text-white break-all"
          >
            {email}
          </p>
        </div>
        <span
          class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-5 py-3 text-sm font-bold text-white shadow-xl shadow-accent-500/25 transition-all hover:-translate-y-0.5 hover:bg-accent-400 dark:shadow-accent-900/40"
        >
          Send Email
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-4 h-4"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
              clip-rule="evenodd"></path>
          </svg>
        </span>
      </a>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          contactChannels.map((channel) => (
            <a
              href={channel.href}
              target={channel.href.startsWith('http') ? '_blank' : undefined}
              rel={
                channel.href.startsWith('http')
                  ? 'noopener noreferrer'
                  : undefined
              }
              class="rounded-2xl border border-warm-200 bg-white p-5 shadow-sm dark:border-warm-800 dark:bg-dark-surface dark:shadow-2xl dark:shadow-black/30"
            >
              <div class="w-10 h-10 flex items-center justify-center bg-accent-100 dark:bg-accent-400/10 rounded-xl">
                {channel.icon === 'mail' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="w-5 h-5 text-accent-600 dark:text-accent-400"
                  >
                    <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
                    <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
                  </svg>
                )}
                {channel.icon === 'linkedin' && (
                  <LinkedInIcon class="w-5 text-accent-600 dark:text-accent-400" />
                )}
                {channel.icon === 'github' && (
                  <GithubIcon class="w-5 text-accent-600 dark:text-accent-400" />
                )}
                {channel.icon === 'globe' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5 text-accent-600 dark:text-accent-400"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
                    />
                  </svg>
                )}
              </div>
              <p class="mt-4 text-sm font-semibold uppercase tracking-wider text-warm-500 dark:text-warm-500">
                {channel.label}
              </p>
              <p class="mt-1 text-lg font-semibold text-warm-900 dark:text-white break-all">
                {channel.value}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-warm-600 dark:text-warm-400">
                {channel.description}
              </p>
            </a>
          ))
        }
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
