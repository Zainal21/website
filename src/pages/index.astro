---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import Introduction from '~/components/Introduction.astro'

const focusAreas = [
  {
    title: 'Backend Development',
    description:
      'Designing scalable APIs and services with Laravel, CodeIgniter, NestJS, Express.js, and Go Fiber — with clean, maintainable, and efficient database architectures.',
    icon: 'server',
  },
  {
    title: 'Mobile Development',
    description:
      'Building cross-platform and native mobile applications with Flutter and Kotlin, from POS systems to customer-facing apps.',
    icon: 'device',
  },
  {
    title: 'Infrastructure & Cloud',
    description:
      'Managing servers, containers, and cloud deployments — Docker, Kubernetes, Nginx, CI/CD pipelines, and monitoring with Grafana and Prometheus for reliable, scalable systems.',
    icon: 'cloud',
  },
  {
    title: 'AI Agents & LLM',
    description:
      'Using AI coding agents and LLM tooling like Claude Code, OpenCode, and GitHub Copilot to accelerate development, automate workflows, and ship faster.',
    icon: 'sparkles',
  },
]
---

<Layout>
  <BaseLayout>
    <Introduction />

    <!-- Focus Areas Section -->
    <section class="mt-16 animate-fade-in-up opacity-0 stagger-4">
      <div class="grid gap-6 sm:grid-cols-2">
        {
          focusAreas.map((area) => (
            <div class="rounded-2xl border border-warm-200 bg-white p-5 dark:border-warm-800 dark:bg-dark-surface">
              <div class="w-10 h-10 flex items-center justify-center bg-warm-100 dark:bg-dark-elevated rounded-xl">
                {area.icon === 'server' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5 text-warm-600 dark:text-warm-300"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z"
                    />
                  </svg>
                )}
                {area.icon === 'device' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5 text-warm-600 dark:text-warm-300"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
                    />
                  </svg>
                )}
                {area.icon === 'cloud' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5 text-warm-600 dark:text-warm-300"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"
                    />
                  </svg>
                )}
                {area.icon === 'sparkles' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5 text-warm-600 dark:text-warm-300"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-2.846-2.846L2.5 12l2.846-.813a4.5 4.5 0 0 0 2.846-2.846L9 5.5l.813 2.846a4.5 4.5 0 0 0 2.846 2.846L15.5 12l-2.846.813a4.5 4.5 0 0 0-2.846 2.846ZM18.25 10.5l.433-1.518a2.25 2.25 0 0 1 1.518-1.518L21.72 7l-1.518-.433a2.25 2.25 0 0 1-1.518-1.518L18.25 3.5l-.433 1.518a2.25 2.25 0 0 1-1.518 1.518L14.78 7l1.518.433a2.25 2.25 0 0 1 1.518 1.518L18.25 10.5Z"
                    />
                  </svg>
                )}
              </div>
              <h3 class="mt-4 font-display text-lg font-semibold tracking-tight text-warm-900 dark:text-white">
                {area.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-warm-600 dark:text-warm-400">
                {area.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <Footer />
  </BaseLayout>
</Layout>
