---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import SkillPage from '~/components/SkillPage.astro'

const intro =
  'I build fast, scalable REST APIs and services with Express.js on Node.js.'

const delivered = [
  'Developed backend services and APIs for the <a href="/work/tekenaja">eKYC platform (TekenAja)</a>, including the Kadin ID membership system and biometric search services for Baintelkam Polri and Kejaksaan Agung.',
  'Contributed to the <a href="/work/oxy">eKYC Service (OCR & Liveness Detection)</a> at OXY Creative.',
  'Built supporting APIs and services across client projects at <a href="/work/katalis">Katalis Kreasi Teknologi</a>.',
]

const why =
  'Express.js lets me move quickly from idea to a working API. My experience there ranges from authentication and identity services to integrating third-party APIs, always with clean structure and solid error handling.'

const projects = [
  { label: 'TekenAja! / OXY Creative', href: '/work/tekenaja' },
  { label: 'OXY Creative', href: '/work/oxy' },
  { label: 'Katalis Kreasi Teknologi', href: '/work/katalis' },
]
---

<Layout
  title="Express.js | Muhamad Zainal Arifin"
  description="Express.js and Node.js experience building APIs and backend services."
>
  <BaseLayout>
    <SkillPage
      title="Express.js"
      intro={intro}
      delivered={delivered}
      why={why}
      projects={projects}
    />
    <Footer />
  </BaseLayout>
</Layout>
