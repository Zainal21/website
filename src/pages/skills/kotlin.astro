---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import SkillPage from '~/components/SkillPage.astro'

const intro =
  'I build native Android applications with Kotlin for logistics, banking, and business use cases.'

const delivered = [
  'Developed the <a href="/work/cikajogja">JTLExpress Official Apps (Android)</a>, JTLExpress Mitra Official Apps, and JTLExpress Kurir Apps at Cikajogja.',
  'Built the <a href="/work/katalis">BPR Dana Mandiri Deposito Agent System</a> mobile app at Katalis Kreasi Teknologi.',
  'Contributed native Android development for client and internal projects across multiple roles.',
]

const why =
  'Kotlin combines modern language features with full native performance. I use it to ship reliable, production-ready Android apps.'

const projects = [
  { label: 'Cikajogja', href: '/work/cikajogja' },
  { label: 'Katalis Kreasi Teknologi', href: '/work/katalis' },
]
---

<Layout
  title="Kotlin | Muhamad Zainal Arifin"
  description="Kotlin experience building native Android applications."
>
  <BaseLayout>
    <SkillPage
      title="Kotlin"
      intro={intro}
      delivered={delivered}
      why={why}
      projects={projects}
    />
    <Footer />
  </BaseLayout>
</Layout>
