---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import SkillPage from '~/components/SkillPage.astro'

const intro =
  'I build maintainable, testable web applications with Laravel — from APIs and dashboards to full ERP systems.'

const delivered = [
  'Designed and built the <a href="/work/katalis">MK Jewelry System (ERP)</a> and <a href="/work/katalis">MK Jewelry POS</a>, including scalable database architecture.',
  'Developed banking services at <a href="/work/katalis">Katalis Kreasi Teknologi</a>, including the BPR Dana Mandiri balance check service, PPOB API, and OpenAPI service.',
  'Built logistics and government dashboards at <a href="/work/cikajogja">Cikajogja</a>, including JTLExpress Cargosistem and the Satpol PP information system.',
  'Delivered invoicing management (<a href="/work/oxy">Catatan UMKM</a>) and house property management (<a href="/work/oxy">Tatangga</a>) systems at OXY Creative.',
]

const why =
  'Laravel gives me a productive, convention-driven framework for shipping reliable features fast. My focus is on clean structure, efficient database design, and code that stays maintainable as the application grows.'

const projects = [
  { label: 'Katalis Kreasi Teknologi', href: '/work/katalis' },
  { label: 'OXY Creative', href: '/work/oxy' },
  { label: 'Cikajogja', href: '/work/cikajogja' },
]
---

<Layout
  title="Laravel | Muhamad Zainal Arifin"
  description="Laravel experience: ERP, POS, banking services, and web applications."
>
  <BaseLayout>
    <SkillPage
      title="Laravel"
      intro={intro}
      delivered={delivered}
      why={why}
      projects={projects}
    />
    <Footer />
  </BaseLayout>
</Layout>
