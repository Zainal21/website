---
import { Image } from 'astro:assets'
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import GithubIcon from '~/icons/GithubIcon.astro'

const projectImages = import.meta.glob('~/assets/projects/**/*.png', {
  eager: true,
  import: 'default',
})

const projectTitles: Record<string, string> = {
  'android-jtlexpress.png': 'JTLExpress Android',
  'biometric-bik.png': 'Baintelkam Polri Biometrik',
  'cargosistem.png': 'Cargo Sistem',
  'catatan-umkm.png': 'Catatan UMKM',
  'jtlexpress.png': 'JTLExpress',
  'kadin.png': 'Kadin Membership System',
  'kejagung-dashboard.png': 'Kejaksaan Agung Biometrik Dashboard',
  'satpol-pp-jogja.png': 'Satpol PP Jogja',
  'school-complaint.png': 'School Complaint',
  'sedo-tekenaja.png': 'Sedo Tekenaja',
  'smkn2kra.png': 'SMKN 2 Kra',
  'tata-ruang-magelang.png': 'Tata Ruang Magelang',
  'tatangga.png': 'Tatangga',
  'treeams.png': 'TREEAMS',
}

// Folder name under assets/projects maps to the employer; order follows the Work page.
const employers: Record<string, string> = {
  oxycreative: 'OXY Creative Inc',
  tekenaja: 'TekenAja!',
  platon: 'Platon',
  linkpos: 'Linkpos Digital Kreatif',
  treeams: 'TreeAMS Pte Ltd (Freelance)',
  cikajogja: 'CV. Cipta Karya Infotika (Cikajogja)',
  school: 'Personal Projects',
}

const projects = Object.entries(projectImages)
  .map(([path, src]) => {
    const parts = path.split('/')
    const filename = parts.pop() ?? ''
    return {
      title: projectTitles[filename] ?? filename.replace('.png', ''),
      employer: parts.pop() ?? '',
      src: src as ImageMetadata,
    }
  })
  .sort((a, b) => a.title.localeCompare(b.title))

const groups = Object.entries(employers)
  .map(([key, label]) => ({
    label,
    projects: projects.filter((p) => p.employer === key),
  }))
  .filter((group) => group.projects.length > 0)
---

<Layout title="What I Built | Muhamad Zainal Arifin">
  <BaseLayout>
    <article class="prose lg:prose-lg mt-12">
      <h1>What I Built</h1>
      <p>
        This page highlights projects I've built and contributed to. For
        professional client work, check out my <a href="/work">Work</a> page.
      </p>

      {
        groups.map((group) => (
          <section class="not-prose">
            <h3 class="mt-10 mb-4 text-lg font-semibold text-warm-900 dark:text-warm-100">
              {group.label}
            </h3>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {group.projects.map((project) => (
                <figure class="ledger-hover-cell group overflow-hidden rounded-2xl border border-warm-200 bg-white dark:border-warm-800 dark:bg-dark-surface">
                  <div class="aspect-video overflow-hidden bg-warm-100 dark:bg-dark-elevated">
                    <Image
                      src={project.src}
                      alt={`${project.title} preview`}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      widths={[480, 640, 960]}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption class="flex items-center justify-between px-4 py-3">
                    <span class="text-sm font-semibold text-warm-900 dark:text-warm-100">
                      {project.title}
                    </span>
                    <span class="ledger-hover-arrow text-warm-400">→</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        ))
      }

      <h2>Open Source</h2>
      <p>
        You can browse my open-source work and experiments on
        <a href="https://github.com/Zainal21">github.com/Zainal21</a>.
      </p>
    </article>

    <div class="mt-8">
      <a
        href="https://github.com/Zainal21"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-2xl border border-warm-200 bg-white px-5 py-4 dark:border-warm-800 dark:bg-dark-surface hover:border-warm-400 dark:hover:border-warm-600 transition-colors"
      >
        <GithubIcon class="w-6 h-6 text-warm-900 dark:text-warm-100" />
        <span class="text-sm font-semibold text-warm-900 dark:text-warm-100">
          github.com/Zainal21
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4 text-warm-500"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
          ></path>
        </svg>
      </a>
    </div>

    <Footer />
  </BaseLayout>
</Layout>
