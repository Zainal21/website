---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'

const pageTitle = 'CV. Cipta Karya Infotika (Cikajogja)'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://zainarief.my.id',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}

const keyProjects = [
  {
    name: 'JTLExpress Cargosistem Dashboard',
    description: 'Logistics operations dashboard for JTLExpress.',
  },
  {
    name: 'JTLExpress Shipper Dashboard',
    description: 'Dashboard for shippers to manage logistics operations.',
  },
  {
    name: 'DKExpress Cargosistem',
    description: 'Logistics cargo system for DKExpress.',
  },
  {
    name: 'Sistem Informasi Tata Ruang Magelang',
    description: 'Spatial information system for Magelang.',
  },
  {
    name: 'Sistem Informasi Satpol PP (Sindega Jawi)',
    description: 'Information system for the Satpol PP civil service.',
  },
  {
    name: 'JTLExpress Official Apps (Android)',
    description: 'Official Android application for JTLExpress customers.',
  },
  {
    name: 'JTLExpress Mitra Official Apps (Android)',
    description: 'Android application for JTLExpress partners.',
  },
  {
    name: 'JTLExpress Kurir Apps (Android)',
    description: 'Android application for JTLExpress couriers.',
  },
]
---

<Layout
  title="Cikajogja - Work | Muhamad Zainal Arifin"
  description="Programmer at Cikajogja: logistics dashboards, government information systems, and Android apps."
>
  <BaseLayout>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <article class="mt-12">
      <a
        href="/work"
        class="inline-flex items-center gap-1 text-sm text-warm-500 dark:text-warm-400 hover:text-warm-700 dark:hover:text-warm-300 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <header class="mb-12">
        <div class="flex items-start gap-5">
          <img
            src="/company/cikajogja.png"
            alt="CV. Cipta Karya Infotika (Cikajogja) logo"
            width="128"
            height="128"
            class="w-16 h-16 rounded-2xl shadow-sm shrink-0"
          />
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-accent-600 dark:text-accent-400"
            >
              Programmer · Jun 2021 – Oct 2022
            </p>
            <h1
              class="mt-2 text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
            >
              CV. Cipta Karya Infotika (Cikajogja)
            </h1>
            <p class="mt-2 text-warm-600 dark:text-warm-400">
              Sleman, Indonesia
            </p>
          </div>
        </div>
      </header>

      <div class="prose lg:prose-lg max-w-none">
        <p>
          Contributed to the full development cycle of various systems, from
          backend logic to frontend interfaces, for both web and mobile
          platforms. Developed critical dashboards and operational tools for
          logistics companies as well as public service systems for government
          institutions.
        </p>

        <h2>Highlights</h2>
        <ul>
          <li>
            Spearheaded collaborative efforts with Project Managers to drive
            seamless application development, ensuring alignment with project
            objectives.
          </li>
          <li>
            Designed and implemented robust, scalable database architectures to
            support high-performance logistics and government information
            systems.
          </li>
          <li>
            Conducted regular maintenance, troubleshooting, and feature
            enhancements that improved application stability and user
            experience.
          </li>
        </ul>

        <h2>Key Projects</h2>
        <ul>
          {
            keyProjects.map((project) => (
              <li>
                <strong>{project.name}:</strong> {project.description}
              </li>
            ))
          }
          <li>And various other internal and client projects.</li>
        </ul>

        <h2>Technology Stack</h2>
        <ul>
          <li>CodeIgniter</li>
          <li>Laravel</li>
          <li>Kotlin (Android)</li>
          <li>MySQL / Relational Databases</li>
          <li>REST APIs</li>
        </ul>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
