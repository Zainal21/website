---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'

const pageTitle = 'Linkpos Digital Kreatif'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://muhamadzain.me',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}
---

<Layout
  title="Linkpos Digital Kreatif - Work | Muhamad Zainal Arifin"
  description="Mobile Engineer at Linkpos Digital Kreatif focused on cross-platform mobile development."
>
  <BaseLayout>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <article class="mt-12">
      <a
        href="/work"
        class="inline-flex items-center gap-1 text-sm text-warm-500 dark:text-warm-400 hover:text-warm-700 dark:hover:text-warm-300 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <header class="mb-12">
        <div class="flex items-start gap-5">
          <img
            src="/company/linkpos-digital-kreatif.webp"
            alt="Linkpos Digital Kreatif logo"
            class="h-16 w-auto max-w-36 object-contain rounded-lg shadow-sm shrink-0"
          />
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-accent-600 dark:text-accent-400"
            >
              Mobile Engineer · May 2026 – Present
            </p>
            <h1
              class="mt-2 text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
            >
              Linkpos Digital Kreatif
            </h1>
            <p class="mt-2 text-warm-600 dark:text-warm-400">Indonesia</p>
          </div>
        </div>
      </header>

      <div class="prose lg:prose-lg max-w-none">
        <p>
          Working as a Mobile Engineer focused on building and maintaining
          cross-platform mobile applications, applying mobile development
          expertise across Flutter and native tooling.
        </p>

        <h2>Technology Stack</h2>
        <ul>
          <li>Flutter</li>
          <li>Cross-platform mobile development</li>
        </ul>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
