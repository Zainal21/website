---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'

const pageTitle = 'OXY Creative'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://zainarief.my.id',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}

const keyProjects = [
  {
    name: 'Tatangga',
    description: 'House property management system.',
  },
  {
    name: 'Catatan UMKM',
    description:
      'Invoicing management system for small and medium enterprises.',
  },
  {
    name: 'eKYC Service',
    description:
      'Electronic Know Your Customer service with OCR and liveness detection.',
  },
  {
    name: 'Various web applications',
    description: 'Internal tools and client web applications.',
  },
]
---

<Layout
  title="OXY Creative - Work | Muhamad Zainal Arifin"
  description="Software Engineer at OXY Creative: SaaS platforms, eKYC, property management, and invoicing systems."
>
  <BaseLayout>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <article class="mt-12">
      <a
        href="/work"
        class="inline-flex items-center gap-1 text-sm text-warm-500 dark:text-warm-400 hover:text-warm-700 dark:hover:text-warm-300 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <header class="mb-12">
        <div class="flex items-start gap-5">
          <img
            src="/company/oxy-creative.png"
            alt="OXY Creative logo"
            class="h-16 w-auto max-w-36 object-contain rounded-lg shadow-sm shrink-0"
          />
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-accent-600 dark:text-accent-400"
            >
              Software Engineer · Nov 2022 – Dec 2024
            </p>
            <h1
              class="mt-2 text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
            >
              OXY Creative
            </h1>
            <p class="mt-2 text-warm-600 dark:text-warm-400">Spring, TX</p>
          </div>
        </div>
      </header>

      <div class="prose lg:prose-lg max-w-none">
        <p>
          Collaborated closely with Project Owners and Project Managers to
          develop user-friendly SaaS platforms, delivering high-quality
          solutions aligned with client needs. Applied scalable system design
          principles throughout the software development lifecycle — from
          planning and development to deployment.
        </p>

        <h2>Highlights</h2>
        <ul>
          <li>
            Designed and implemented efficient database structures and
            supporting tools to ensure smooth application performance and
            seamless user experience.
          </li>
          <li>
            Conducted regular maintenance, troubleshooting, and feature
            enhancements that continuously improved application stability and
            functionality.
          </li>
          <li>
            Worked cross-functionally with multiple teams to integrate new
            features into the existing system architecture effectively.
          </li>
          <li>
            Optimized database performance and architecture to support
            reliability, speed, and long-term scalability.
          </li>
        </ul>

        <h2>Key Projects</h2>
        <ul>
          {
            keyProjects.map((project) => (
              <li>
                <strong>{project.name}:</strong> {project.description}
              </li>
            ))
          }
        </ul>

        <h2>Technology Stack</h2>
        <ul>
          <li>Laravel</li>
          <li>Express.js</li>
          <li>React.js</li>
          <li>MySQL / Relational Databases</li>
          <li>REST APIs</li>
        </ul>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
